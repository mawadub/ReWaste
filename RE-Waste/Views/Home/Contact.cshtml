@{
    ViewData["Title"] = "Contact";
}

<div class="text-center">
    <h1 class="display-4">Contact Re-Waste</h1>
    <p>
        Re-Waste is created to help people
        make better decisions about their old electronic devices.
    </p>

    <div id ="contact">
    <form id ="contactForm">
        <label for="name">Name:</label><br>
        <input type="text" id="name" name="name"><br><br>

        <label for="email">Email:</label><br>
        <input type="email" id="email" name="email"><br><br>

        <label for="message">Message:</label><br>
        <textarea id="message" name="message" rows="4" cols="30"></textarea>
        <br> <br>

        <button class ="button">Submit</button>
    </form>

    <div id ="contactDiv">
        <img src ="/Images/mascot.png" alt = "A drawing of the Re-Waste mascot: a broken tablet with an eyepatch smiling." width="90%">
            <p>
                Re-Waste helps people find out
                what they can do with their old phones, whether
                that means repairing, reselling, donating or recycling them.
            </p>
    </div>
    </div>

</div>
