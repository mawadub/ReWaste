@using RE_Waste.Extensions
@model List<RE_Waste.Models.SavedResponse>

@{
    ViewData["Title"] = "My devices";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <h1 class="h3 mb-3">My devices</h1>

        @* U6: confirmation after a delete, e.g. "Saved result deleted." *@
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success" role="status">@message</div>
        }

        @if (Model.Count == 0)
        {
            <div class="card shadow-sm p-4 text-dark" data-bs-theme="light">
                <p class="mb-3">You have not saved anything yet.</p>
                <div>
                    <a class="btn btn-primary" asp-controller="Wizard" asp-action="Start">Check a phone</a>
                </div>
            </div>
        }
        else
        {
            foreach (var item in Model)
            {
                <div class="card shadow-sm p-3 mb-3 text-dark" data-bs-theme="light">
                    <h2 class="h5 mb-1">@item.Brand @item.Model</h2>
                    <p class="mb-1">Saved on @item.CreatedAt.ToString("dd MMM yyyy")</p>
                    <p class="mb-0">Top recommendation: <strong>@item.Route1.ToDisplayName()</strong></p>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@item.Id">View</a>
                        <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">
                            Delete<span class="visually-hidden"> @item.Brand @item.Model</span>
                        </a>
                    </div>
                </div>
            }
        }
    </div>
</div>