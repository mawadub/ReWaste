@using RE_Waste.Extensions
@model RE_Waste.Models.SavedResponse

@{
    ViewData["Title"] = "Delete saved result";
}

@* ====================================================================
   CONFIRM DELETE (U6, styled to match the wizard)
   One white card. Deleting only happens through the POST form below.
   Styles: "WIZARD", "MANAGER AREA", "RESULTS (R6)" and "MY DEVICES".
   ==================================================================== *@
<div class="wizard">

    <div class="wizard-card">

        <h1 class="text-break">Delete your saved result for @Model.Brand @Model.Model?</h1>

        @* Enough detail to be sure it's the right one. *@
        <dl class="saved-details">
            <dt>Saved on</dt>
            <dd>@Model.CreatedAt.ToString("dd MMM yyyy")</dd>

            <dt>Top recommendation</dt>
            <dd>@Model.Route1.ToDisplayName()</dd>
        </dl>

        <p class="results-note mt-3">This can't be undone.</p>

        @* Delete first, so it's the first button for keyboard users; Cancel next to it. *@
        <div class="manager-actions saved-actions">
            <form asp-action="DeleteConfirmed"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="button-danger">Yes, delete</button>
            </form>

            <a class="button-secondary" asp-action="Index">Cancel</a>
        </div>
    </div>

</div>
