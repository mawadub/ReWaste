@using RE_Waste.Extensions
@model RE_Waste.ViewModels.SavedResponseDetailsViewModel

@{
    ViewData["Title"] = "Saved result";
    var saved = Model.Saved;
}

@* ====================================================================
   SAVED RESULT (U5, styled to match the results page)
   The same stack of white cards as Wizard/Results:
     1. the phone and its details,
     2. one card per saved route, best first, with nearby places,
     3. the buttons.
   Styles: "WIZARD", "RESULTS (R6)" and "MY DEVICES" in site.css.
   ==================================================================== *@
<div class="wizard">

    @* Lavender back link on the blue page, as in the manager area. *@
    <a class="manager-back" asp-action="Index">Back to My devices</a>

    @* ---------- 1. The phone ---------- *@
    <div class="wizard-card">

        <h1 class="text-break">@saved.Brand @saved.Model</h1>

        <p class="wizard-hint">Saved on @saved.CreatedAt.ToString("dd MMM yyyy")</p>

        @* What the user told the wizard, in plain words.
           Brand and model are already in the heading. *@
        <dl class="saved-details">
            <dt>Age</dt>
            <dd>@saved.AgeInYears @(saved.AgeInYears == 1 ? "year" : "years")</dd>

            <dt>Condition</dt>
            <dd>@saved.Condition.ToDisplayName()</dd>

            <dt>Personal data</dt>
            <dd>@(saved.HasPersonalData ? "Yes" : "No")</dd>

            <dt>Battery damage</dt>
            <dd>@(saved.HasBatteryDamage ? "Yes" : "No")</dd>

            <dt>Postcode area</dt>
            <dd>@saved.PostcodeDistrict</dd>
        </dl>

        @* Saved results keep only the district, so distances are approximate. *@
        @if (Model.LocationFound)
        {
            <p class="wizard-hint mt-3 mb-0">
                Distances are measured from the middle of @saved.PostcodeDistrict.
            </p>
        }
        else
        {
            <p class="results-note mt-3 mb-0" role="status">
                We couldn't look up places near @saved.PostcodeDistrict right now.
            </p>
        }
    </div>

    @* ---------- 2. One card per saved route, best first ---------- *@
    @for (var i = 0; i < Model.Routes.Count; i++)
    {
        var route = Model.Routes[i];

        <section class="wizard-card results-route" aria-labelledby="route-@i">

            @* Only the first card gets the label, as on the results page. *@
            @if (i == 0)
            {
                <p class="results-best">Best option</p>
            }

            <h2 id="route-@i">@route.Route.ToDisplayName()</h2>

            @* The reason exactly as it was saved. *@
            <p>@route.Reason</p>

            @if (Model.LocationFound)
            {
                if (route.Places.Count == 0)
                {
                    <p class="results-note mb-0">We don't know of a suitable place near you yet.</p>
                }
                else
                {
                    <h3 class="results-places-heading">Nearest places</h3>

                    <ul class="results-places">
                        @foreach (var place in route.Places)
                        {
                            <li class="results-place">

                                @* Name left, distance right; they wrap at 360 px. *@
                                <div class="results-place-top">
                                    <strong class="text-break">@place.Point.Name</strong>
                                    <span class="results-distance">@place.DistanceKm.ToString("0.0") km</span>
                                </div>

                                <div class="text-break">@place.Point.Address, @place.Point.Postcode</div>

                                <div class="results-type">@place.Point.PointType.ToDisplayName()</div>

                                @* Optional extras from the manager's drop-off point form. *@
                                @if (!string.IsNullOrWhiteSpace(place.Point.OpeningHours))
                                {
                                    <div class="saved-extra text-break">Opening hours: @place.Point.OpeningHours</div>
                                }

                                @if (!string.IsNullOrWhiteSpace(place.Point.Website))
                                {
                                    <a class="saved-extra d-inline-block" href="@place.Point.Website" target="_blank" rel="noopener">
                                        Website<span class="visually-hidden"> for @place.Point.Name (opens in a new tab)</span>
                                    </a>
                                }
                            </li>
                        }
                    </ul>
                }
            }
        </section>
    }

    @* ---------- 3. Buttons ---------- *@
    <div class="wizard-card results-route">
        <div class="manager-actions">
            <a class="button-secondary" asp-action="Index">Back to My devices</a>
            <a class="button-danger" asp-action="Delete" asp-route-id="@saved.Id">Delete this result</a>
        </div>
    </div>

</div>
