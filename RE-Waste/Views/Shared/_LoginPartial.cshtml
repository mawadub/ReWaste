@using Microsoft.AspNetCore.Identity
@using RE_Waste.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    // Show the visitor's Name (collected at registration); fall back to the e-mail for accounts without one.
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = string.IsNullOrWhiteSpace(currentUser?.Name) ? User.Identity?.Name : currentUser.Name;
    <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="MyDevices" asp-action="Index">My devices</a>
    </li>
    
    <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @displayName!</a>
    </li>
    <li class="nav-item">
        <form  class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button  type="submit" class="nav-link btn btn-link text-dark">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
