@model RE_Waste.ViewModels.WizardReviewViewModel

@{
    ViewData["Title"] = "Check your answers";
}

@* ====================================================================
   REVIEW PAGE (W6)
   Every answer in plain words, each with a Change link. The finish
   page, so it gets the mascot (styles: "WIZARD" in site.css).
   ==================================================================== *@
<div class="wizard">

    <div class="wizard-card">

        @* Decorative, so the alt text is empty. *@
        <img class="wizard-mascot" src="~/Images/mascot.png" alt="" />

        <h1>Check your answers</h1>

        <p class="wizard-hint">
            Make sure everything is right before we find the best option for your phone.
        </p>

        @* A plain table with no fixed widths, so long text wraps
           instead of scrolling sideways at 360 px. *@
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Question</th>
                    <th scope="col">Answer</th>
                    <th scope="col" class="text-end">Change</th>
                </tr>
            </thead>

            <tbody>
                @* One row per question, in the order the wizard asks them. *@
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.Question</td>
                        <td class="fw-semibold text-break">@row.Answer</td>
                        <td class="text-end">
                            @* GoTo opens this question with its answer filled in. *@
                            <a asp-controller="Wizard"
                               asp-action="GoTo"
                               asp-route-step="@row.Step">
                                Change<span class="visually-hidden"> answer to: @row.Question</span>
                            </a>
                        </td>
                    </tr>
                }

                @* Last row: the postcode from W4, changed on its own page. *@
                <tr>
                    <td>Your postcode</td>
                    <td class="fw-semibold">@Model.Postcode</td>
                    <td class="text-end">
                        <a asp-controller="Wizard"
                           asp-action="Postcode">
                            Change<span class="visually-hidden"> your postcode</span>
                        </a>
                    </td>
                </tr>
            </tbody>
        </table>

        @* ============================================================
           BUTTONS
           W7's Recommend action builds the Device and shows the routes.
           ============================================================ *@
        <div class="wizard-buttons wizard-actions">
            <form asp-controller="Wizard"
                  asp-action="Recommend"
                  method="post"
                  class="wizard-next">

                @Html.AntiForgeryToken()

                <button type="submit" class="button">
                    Get my recommendation
                </button>
            </form>
        </div>

        @* The existing Restart action: wipes the answers and starts again. *@
        <form asp-controller="Wizard"
              asp-action="Restart"
              method="post"
              class="wizard-restart-form">

            @Html.AntiForgeryToken()

            <button type="submit" class="wizard-restart">Start again</button>
        </form>

    </div>
</div>
