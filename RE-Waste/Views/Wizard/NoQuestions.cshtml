@{
    ViewData["Title"] = "No Questions Available";
}

@* ====================================================================
   NO QUESTIONS
   Shown when a manager has switched off every question. Same card as
   the wizard, with the mascot (styles: "WIZARD" in site.css).
   ==================================================================== *@
<div class="wizard">

    <div class="wizard-card text-center">

        @* Decorative, so the alt text is empty. *@
        <img class="wizard-mascot" src="~/Images/mascot.png" alt="" />

        <h1>No questions available</h1>

        <p class="wizard-hint">
            There are no active questions right now.
            Please try again later.
        </p>

        @* Restart only accepts POST, so it has to be a form, not a link. *@
        <form asp-controller="Wizard"
              asp-action="Restart"
              method="post"
              class="wizard-restart-form">

            @Html.AntiForgeryToken()

            <button type="submit" class="wizard-restart">Start again</button>
        </form>

    </div>
</div>
