@model RE_Waste.Models.Question

@using RE_Waste.Models.Enums

@{
    ViewData["Title"] = "Wizard";

    var stepNumber = (int)ViewBag.StepNumber;
    var totalSteps = (int)ViewBag.TotalSteps;
    var isLast = (bool)ViewBag.IsLast;
    var currentAnswer = ViewBag.CurrentAnswer?.ToString() ?? "";
}

<div class="container py-4">
    <div class="card bg-white shadow-sm mx-auto"
         style="max-width: 650px;">
        <div class="card-body p-4">
            <p class="text-muted">
                Question @stepNumber of @totalSteps
            </p>

            <h2 class="mb-4">@Model.Text</h2>

            <form asp-controller="Wizard"
                  asp-action="Next"
                  method="post">

                @Html.AntiForgeryToken()

                @if (Model.AnswerType == AnswerType.Choice)
                {
                    @foreach (var option in Model.Options)
                    {
                        var selected =
                        currentAnswer == option.Value.ToString();

                        <div class="form-check mb-3">
                            <input class="form-check-input"
                                   type="radio"
                                   name="answer"
                                   id="option_@option.Value"
                                   value="@option.Value"
                                   checked="@selected"
                                   required />

                            <label class="form-check-label"
                                   for="option_@option.Value">
                                @option.Text
                            </label>
                        </div>
                    }
                }
                else if (Model.AnswerType == AnswerType.Number)
                {
                    <input class="form-control"
                           type="number"
                           name="answer"
                           min="0"
                           value="@currentAnswer"
                           required />
                }
                else if (Model.AnswerType == AnswerType.Text)
                {
                    <input class="form-control"
                           type="text"
                           name="answer"
                           value="@currentAnswer"
                           required />
                }

                <div class="d-flex justify-content-between mt-4">
                    <div>
                        @if (stepNumber > 1)
                        {
                            <a asp-controller="Wizard"
                               asp-action="Back"
                               class="btn btn-outline-secondary">
                                Back
                            </a>
                        }
                    </div>

                    <button type="submit" class="btn btn-primary">
                        @(isLast ? "Finish" : "Next")
                    </button>
                </div>
            </form>

            <form asp-controller="Wizard"
                  asp-action="Restart"
                  method="post"
                  class="mt-3">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-link px-0">
                    Restart
                </button>
            </form>
        </div>
    </div>
</div>
