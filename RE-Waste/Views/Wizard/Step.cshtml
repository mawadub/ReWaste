@model RE_Waste.Models.Question

@using RE_Waste.Models.Enums
@using RE_Waste.Models
@using RE_Waste.Services

@{
    ViewData["Title"] = "Wizard";

    var stepNumber = (int)ViewBag.StepNumber;
    var totalSteps = (int)ViewBag.TotalSteps;
    var isLast = (bool)ViewBag.IsLast;
    var currentAnswer = ViewBag.CurrentAnswer?.ToString() ?? "";

    // W5: the server's error message, if the last answer was refused,
    // and the name of the box it belongs to ("answer" unless the Model step says otherwise).
    var error = ViewBag.ErrorMessage as string;
    var errorField = ViewBag.ErrorField as string ?? "answer";

    // Bootstrap and screen-reader attributes for the box with the error.
    // A null value makes Razor leave the attribute out completely.
    Func<string, string> invalidFor = field => error != null && errorField == field ? "is-invalid" : "";
    Func<string, string?> describedFor = field => error != null && errorField == field ? "answerError" : null;
    Func<string, string?> ariaInvalidFor = field => error != null && errorField == field ? "true" : null;

    var invalidClass = invalidFor("answer");
    var describedBy = describedFor("answer");
    var ariaInvalid = ariaInvalidFor("answer");

    // Model step: listed brand gets a searchable list, "Other" gets brand and model boxes.
    var brandListed = ViewBag.BrandListed as bool? ?? true;
    var modelOptions = ViewBag.ModelOptions as List<string> ?? new List<string>();
    var otherBrand = ViewBag.OtherBrand as string ?? "";
    var otherModel = ViewBag.OtherModel as string ?? "";
    var otherModelChosen = currentAnswer == PhoneModel.Other;

    // Age step: an estimate from the release year, only for a model from the list.
    var estimatedAge = ViewBag.EstimatedAge as int?;
    var releaseYear = ViewBag.ReleaseYear as int?;
    var phoneName = ViewBag.PhoneName as string ?? "";

    // Open the number box straight away when there is no estimate, the user already
    // gave a different age, or their age was refused.
    var showOwnAge = estimatedAge == null
        || error != null
        || (currentAnswer != "" && currentAnswer != estimatedAge.ToString());

    // Store hints by DeviceField so question wording can change safely.
    var hints = new Dictionary<DeviceField, string>
    {
        { DeviceField.Brand, "Choose the brand of your phone." },
        { DeviceField.Model, "Start typing to search, or choose Other if yours isn't listed." },
        { DeviceField.AgeInYears, "Enter the phone's age in whole years." },
        { DeviceField.Condition, "Choose the option that best describes your phone." },
        { DeviceField.HasPersonalData, "Tell us whether personal data is still on the phone." },
        { DeviceField.HasBatteryDamage, "Tell us whether the battery is damaged." }
    };

    if (!brandListed)
    {
        hints[DeviceField.Model] = "Your brand isn't in our list, so please type the brand and model.";
    }

    if (estimatedAge != null)
    {
        hints[DeviceField.AgeInYears] = "We worked this out from the year the model came out. If you got your phone later, enter your own.";
    }
}

<div class="container py-4">

    @* ================================================================
       WIZARD CARD
       Displays the current question and its answer input.
       ================================================================ *@
    <div class="card bg-white shadow-sm mx-auto"
         style="max-width: 650px;">

        <div class="card-body p-4">

            @* Display the current question number and total questions. *@
            <p class="text-muted">
                Question @stepNumber of @totalSteps
            </p>


            @* Display the question loaded from the database. *@
            <h2 class="mb-2">@Model.Text</h2>

            @* Display the hint associated with this question's DeviceField. *@
            @if (hints.TryGetValue(Model.DeviceField, out var hint))
            {
                <p class="text-muted small mb-4">@hint</p>
            }

            @* Submit the answer to the Next action. *@
            <form asp-controller="Wizard"
                  asp-action="Next"
                  method="post">

                @* Protect the form against cross-site request forgery. *@
                @Html.AntiForgeryToken()

                @* ====================================================
                   BRAND
                   Show a drop-down when the current field is Brand.
                   ==================================================== *@
                @if (Model.DeviceField == DeviceField.Brand)
                {
                    <select class="form-select @invalidClass"
                            name="answer"
                            aria-describedby="@describedBy"
                            aria-invalid="@ariaInvalid"
                            required>
                        <option value="">Select a brand</option>

                        @foreach (var brand in PhoneBrands.All)
                        {
                            <option value="@brand"
                                    selected="@(currentAnswer == brand)">
                                @brand
                            </option>
                        }
                    </select>
                }

                @* ====================================================
                   MODEL
                   Searchable drop-down of models for the chosen brand,
                   with a box for a model that isn't listed. When the
                   brand was "Other", the user types brand and model.
                   ==================================================== *@
                else if (Model.DeviceField == DeviceField.Model)
                {
                    @if (brandListed)
                    {
                        <select id="modelSelect"
                                class="form-select @invalidClass"
                                name="answer"
                                aria-describedby="@describedBy"
                                aria-invalid="@ariaInvalid"
                                required>
                            <option value="">Search or select a model</option>

                            @foreach (var m in modelOptions)
                            {
                                <option value="@m" selected="@(currentAnswer == m)">@m</option>
                            }
                        </select>

                        @* Shown only when "Other / not listed" is chosen. A hidden box is
                           disabled, so the browser doesn't check it and doesn't send it. *@
                        <div id="otherModelBox" class="mt-3" hidden="@(!otherModelChosen)">
                            <label for="otherModel" class="form-label">Type your phone's model</label>
                            <input id="otherModel"
                                   class="form-control @(invalidFor("otherModel"))"
                                   type="text"
                                   name="otherModel"
                                   maxlength="@AnswerValidator.MaxLength(DeviceField.Model)"
                                   placeholder="For example Galaxy S7"
                                   value="@otherModel"
                                   aria-describedby="@(describedFor("otherModel"))"
                                   aria-invalid="@(ariaInvalidFor("otherModel"))"
                                   disabled="@(!otherModelChosen)"
                                   required />
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label for="otherBrand" class="form-label">Brand</label>
                            <input id="otherBrand"
                                   class="form-control @(invalidFor("otherBrand"))"
                                   type="text"
                                   name="otherBrand"
                                   maxlength="@AnswerValidator.MaxLength(DeviceField.Brand)"
                                   placeholder="For example Fairphone"
                                   value="@otherBrand"
                                   aria-describedby="@(describedFor("otherBrand"))"
                                   aria-invalid="@(ariaInvalidFor("otherBrand"))"
                                   required />
                        </div>

                        <div>
                            <label for="otherModel" class="form-label">Model</label>
                            <input id="otherModel"
                                   class="form-control @(invalidFor("otherModel"))"
                                   type="text"
                                   name="otherModel"
                                   maxlength="@AnswerValidator.MaxLength(DeviceField.Model)"
                                   placeholder="For example Fairphone 4"
                                   value="@otherModel"
                                   aria-describedby="@(describedFor("otherModel"))"
                                   aria-invalid="@(ariaInvalidFor("otherModel"))"
                                   required />
                        </div>
                    }
                }

                @* ====================================================
                   AGE
                   For a model from the list, show the estimate from its
                   release year with Agree / Enter yours. Otherwise, or
                   after Enter yours, a whole number between 0 and 30.
                   ==================================================== *@
                else if (Model.DeviceField == DeviceField.AgeInYears)
                {
                    @if (estimatedAge != null)
                    {
                        <div class="border rounded p-3 mb-3">
                            <p class="mb-0">
                                The <strong>@phoneName</strong> came out in @releaseYear,
                                so your phone is about
                                <strong>@estimatedAge @(estimatedAge == 1 ? "year" : "years") old</strong>.
                            </p>

                            @* Removed by "Enter yours", so Enter in the number box
                               submits the typed age, not this estimate. *@
                            @if (!showOwnAge)
                            {
                                <div id="ageEstimateButtons" class="d-flex flex-wrap gap-2 mt-3">
                                    <button type="submit"
                                            name="answer"
                                            value="@estimatedAge"
                                            class="btn btn-primary">
                                        Agree
                                    </button>

                                    <button type="button"
                                            id="enterOwnAge"
                                            class="btn btn-outline-secondary">
                                        Enter yours
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    <div id="ownAge" hidden="@(!showOwnAge)">
                        <input id="ageInput"
                               class="form-control @invalidClass"
                               type="number"
                               name="answer"
                               min="@AnswerValidator.MinNumber"
                               max="@AnswerValidator.MaxNumber"
                               step="1"
                               value="@currentAnswer"
                               aria-label="Age in years"
                               aria-describedby="@describedBy"
                               aria-invalid="@ariaInvalid"
                               disabled="@(!showOwnAge)"
                               required />
                    </div>
                }

                @* ====================================================
                   OTHER CHOICE QUESTIONS
                   Keep the existing radio-button behaviour.
                   ==================================================== *@
                else if (Model.AnswerType == AnswerType.Choice)
                {
                    @foreach (var option in Model.Options)
                    {
                        <div class="form-check mb-3">
                            <input class="form-check-input @invalidClass"
                                   type="radio"
                                   name="answer"
                                   id="option_@option.Id"
                                   value="@option.Value"
                                   checked="@(currentAnswer == option.Value)"
                                   aria-describedby="@describedBy"
                                   aria-invalid="@ariaInvalid"
                                   required />

                            <label class="form-check-label"
                                   for="option_@option.Id">
                                @option.Text
                            </label>
                        </div>
                    }
                }

                @* Keep the generic number input for other number questions. *@
                else if (Model.AnswerType == AnswerType.Number)
                {
                    <input class="form-control @invalidClass"
                           type="number"
                           name="answer"
                           min="@AnswerValidator.MinNumber"
                           max="@AnswerValidator.MaxNumber"
                           step="1"
                           value="@currentAnswer"
                           aria-describedby="@describedBy"
                           aria-invalid="@ariaInvalid"
                           required />
                }

                @* Keep the generic text input for other text questions. *@
                else if (Model.AnswerType == AnswerType.Text)
                {
                    <input class="form-control @invalidClass"
                           type="text"
                           name="answer"
                           maxlength="@AnswerValidator.MaxLength(Model.DeviceField)"
                           value="@currentAnswer"
                           aria-describedby="@describedBy"
                           aria-invalid="@ariaInvalid"
                           required />
                }

                @* ====================================================
                   ERROR MESSAGE (W5)
                   Shown when the server refused the answer.
                   ==================================================== *@
                @if (error != null)
                {
                    <div id="answerError" class="invalid-feedback d-block" role="alert">
                        @error
                    </div>
                }

                @* ====================================================
                   NAVIGATION BUTTONS
                   Show Back when available and change Next to Finish
                   on the final question. Next is hidden while the age
                   estimate offers Agree / Enter yours instead.
                   ==================================================== *@
                <div class="d-flex justify-content-between mt-4">

                    <div>
                        @* Hide Back on the first question. *@
                        @if (stepNumber > 1)
                        {
                            <a asp-controller="Wizard"
                               asp-action="Back"
                               class="btn btn-outline-secondary">
                                Back
                            </a>
                        }
                    </div>

                    @* Submit the answer and continue the wizard. *@
                    <button type="submit"
                            id="nextButton"
                            class="btn btn-primary"
                            hidden="@(Model.DeviceField == DeviceField.AgeInYears && !showOwnAge)">
                        @(isLast ? "Finish" : "Next")
                    </button>
                </div>
            </form>

            @* ========================================================
               RESTART
               Clear saved progress and begin the wizard again.
               ======================================================== *@
            <form asp-controller="Wizard"
                  asp-action="Restart"
                  method="post"
                  class="mt-3">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-link px-0">
                    Restart
                </button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script>
        // MODEL: searchable list, plus the extra box when "Other / not listed" is chosen.
        var modelSelect = document.getElementById("modelSelect");
        var otherModelBox = document.getElementById("otherModelBox");
        var otherModelInput = document.getElementById("otherModel");
        var otherModelValue = @Json.Serialize(PhoneModel.Other);

        function toggleOtherModel(value) {
            if (typeof value !== "string") {
                value = modelSelect.value;
            }

            var show = value === otherModelValue;
            otherModelBox.hidden = !show;
            otherModelInput.disabled = !show; // a hidden box is not checked or sent

            if (show) {
                otherModelInput.focus();
            }
        }

        if (modelSelect) {
            if (window.TomSelect) {
                new TomSelect(modelSelect, { create: false, onChange: toggleOtherModel });
            } else {
                modelSelect.addEventListener("change", toggleOtherModel);
            }
        }

        // AGE: "Enter yours" swaps the estimate buttons for the number box and Next.
        var enterOwnAge = document.getElementById("enterOwnAge");

        if (enterOwnAge) {
            enterOwnAge.addEventListener("click", function () {
                var ageInput = document.getElementById("ageInput");

                document.getElementById("ageEstimateButtons").remove();
                document.getElementById("ownAge").hidden = false;
                document.getElementById("nextButton").hidden = false;

                ageInput.disabled = false;
                ageInput.value = "";
                ageInput.focus();
            });
        }
    </script>
}
