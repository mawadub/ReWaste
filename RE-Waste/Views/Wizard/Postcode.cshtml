@model string

@{
    ViewData["Title"] = "Your postcode";
    var error = ViewBag.ErrorMessage as string;
}

@* ====================================================================
   POSTCODE PAGE (W4)
   The last step, after the questions. Same white question card as the
   question pages (styles: "WIZARD" in site.css).
   ==================================================================== *@
<div class="wizard">

    <div class="wizard-card">

        @* The questions are done, so the bar is full. *@
        <p class="wizard-step" id="stepLabel">Last step</p>

        <progress class="wizard-progress"
                  value="1"
                  max="1"
                  aria-labelledby="stepLabel">
            Last step
        </progress>

        <form asp-controller="Wizard"
              asp-action="Postcode"
              method="post">

            @Html.AntiForgeryToken()

            @* The heading is also the label of the postcode box. *@
            <h1><label for="postcode">Your postcode</label></h1>

            <p id="postcodeHint" class="wizard-hint">
                We only use it to find places near you.
            </p>

            @* Keep what the user typed and highlight the box on errors. *@
            <input class="form-control @(error != null ? "is-invalid" : "")"
                   type="text"
                   id="postcode"
                   name="postcode"
                   value="@Model"
                   maxlength="8"
                   autocomplete="postal-code"
                   placeholder="EH1 2NG"
                   aria-describedby="postcodeHint @(error != null ? "postcodeError" : "")"
                   required />

            @if (error != null)
            {
                <div id="postcodeError" class="invalid-feedback d-block" role="alert">
                    @error
                </div>
            }

            @* ========================================================
               NAVIGATION BUTTONS
               Back returns to the last question. Phones: Continue on
               top, Back below; from 576 px on one row.
               ======================================================== *@
            <div class="wizard-buttons wizard-actions">
                <a asp-controller="Wizard"
                   asp-action="Back"
                   class="button-secondary">
                    Back
                </a>

                <button type="submit" class="button wizard-next">
                    Continue
                </button>
            </div>
        </form>

        @* Clear saved progress and begin the wizard again. *@
        <form asp-controller="Wizard"
              asp-action="Restart"
              method="post"
              class="wizard-restart-form">

            @Html.AntiForgeryToken()

            <button type="submit" class="wizard-restart">Start again</button>
        </form>

    </div>
</div>
