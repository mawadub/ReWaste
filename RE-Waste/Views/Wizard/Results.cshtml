@using RE_Waste.Extensions
@using System.Text.Json
@model RE_Waste.ViewModels.ResultsViewModel

@{
    ViewData["Title"] = "Your recommendation";

    // Collect all recommended locations from every route for the map.
    var mapPoints = Model.Routes
        .SelectMany(route => route.Places.Select(place => new
        {
            // The coordinates tell Leaflet where to place the marker.
            Latitude = place.Point.Latitude,
            Longitude = place.Point.Longitude,

            // Information displayed when the marker is clicked.
            Name = place.Point.Name,
            Address = place.Point.Address,
            Postcode = place.Point.Postcode,
            Route = route.Route.ToDisplayName(),
            DistanceKm = place.DistanceKm
        }))
        .ToList();
}

@* ====================================================================
   RESULTS PAGE (R6)
   Replaces W7's temporary page. A stack of white wizard cards:
     1. a heading card (with a note if we couldn't use the postcode),
     2. one card per route, best first: name, reason, up to 3 places,
     3. a last card with the buttons (and V1's Save button).
   Styles: "WIZARD" and "RESULTS (R6)" in site.css.
   ==================================================================== *@
<div class="wizard">

    @* ---------- 1. Heading card ---------- *@
    <div class="wizard-card">

        @* Decorative, so the alt text is empty. *@
        <img class="wizard-mascot" src="~/Images/mascot.png" alt="" />

        <h1>Your recommendation</h1>

        @if (Model.HasLocation)
        {
            <p class="wizard-hint">
                Here are the best options for your phone, best first, with places near @Model.Postcode.
            </p>
        }
        else
        {
            <p class="wizard-hint">
                Here are the best options for your phone, best first.
            </p>

            @* Bad or missing postcode, or postcodes.io is down: routes still show, places don't.
               role="status" lets screen readers announce the note. *@
            <p class="results-note mb-0" role="status">
                We couldn't find places near your postcode right now.
                You can <a asp-controller="Wizard" asp-action="Postcode">check your postcode</a>
                and try again.
            </p>
        }
    </div>

    @* ============================================================
       MAP
       Displays all recommended drop-off locations.
       Each marker shows the location details when clicked.
       ============================================================ *@

    @if (Model.HasLocation && mapPoints.Count > 0)
    {
        <div class="wizard-card">

            <h2>Nearby drop-off locations</h2>

            <p class="wizard-hint">
                Select a marker to see more information about a location.
            </p>

            @* Leaflet will display the interactive map inside this div. *@
            <div id="recommendationMap"
                 style="height: 350px; width: 100%; border-radius: 10px;">
            </div>

        </div>
    }

    @* ---------- 2. One card per route, best first ---------- *@
    @for (var i = 0; i < Model.Routes.Count; i++)
    {
        var route = Model.Routes[i];

        @* aria-labelledby names each card after its route for screen readers. *@
        <section class="wizard-card results-route" aria-labelledby="route-@i">

            @* Only the first card gets the "Best option" label. *@
            @if (i == 0)
            {
                <p class="results-best">Best option</p>
            }

            @* Route name in plain words, e.g. "Resale or trade-in". *@
            <h2 id="route-@i">@route.Route.ToDisplayName()</h2>

            @* The engine's reason, word for word (never rewritten here). *@
            <p>@route.Reason</p>

            @* Places only when we know where the user is. Otherwise the note in
               the heading card already explains why they're missing. *@
            @if (Model.HasLocation)
            {
                if (route.Places.Count == 0)
                {
                    <p class="results-note mb-0">We don't know of a suitable place near you yet.</p>
                }
                else
                {
                    <h3 class="results-places-heading">Nearest places</h3>

                    <ul class="results-places">
                        @foreach (var place in route.Places)
                        {
                            <li class="results-place">

                                @* Name on the left, distance on the right; they wrap at 360 px.
                                   Distance is in km with one decimal place, e.g. "3.2 km". *@
                                <div class="results-place-top">
                                    <strong class="text-break">@place.Point.Name</strong>
                                    <span class="results-distance">@place.DistanceKm.ToString("0.0") km</span>
                                </div>

                                @* text-break so a long address wraps instead of scrolling sideways. *@
                                <div class="text-break">@place.Point.Address, @place.Point.Postcode</div>

                                @* The type in plain words, e.g. "Recycling centre". *@
                                <div class="results-type">@place.Point.PointType.ToDisplayName()</div>
                            </li>
                        }
                    </ul>
                }
            }
        </section>
    }

    @* ---------- 3. Buttons ---------- *@
    <div class="wizard-card results-route">


        <div class="wizard-buttons wizard-actions">
            @* Back to the review page; the answers are still in the session. *@
            <a class="button-secondary"
               asp-controller="Wizard"
               asp-action="Complete">
                Back to my answers
            </a>

            @* ============================================================
               V1: SAVE THIS RESULT
               Only shown to logged-in users. The form sends only the
               anti-forgery token: Save reads the result from the session
               and the user id from the login, never from the form.
               Logged-out users see nothing here yet (V2 adds that).
               class="wizard-next" pushes it to the right, like the main
               button on the review page.
               ============================================================ *@
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Wizard"
                      asp-action="Save"
                      method="post"
                      class="wizard-next">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="button">Save this result</button>
                </form>
            }
        </div>

        @* The existing Restart action: wipes the answers, and Start wipes the result. *@
        <form asp-controller="Wizard"
              asp-action="Restart"
              method="post"
              class="wizard-restart-form">

            @Html.AntiForgeryToken()

            <button type="submit" class="wizard-restart">Start again</button>
        </form>
    </div>

</div>

@section Scripts {

    <script>

        // Receive the recommended locations from the Razor view.
        const locations = @Html.Raw(JsonSerializer.Serialize(mapPoints));

        // Only create the map if there are locations to display.
        if (locations.length > 0) {

            // Create the map inside the recommendationMap div.
            const map = L.map('recommendationMap');

            // Add OpenStreetMap tiles to provide the map background.
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            // Store markers so the map can zoom to include all locations.
            const markers = [];

            // Loop through every recommended location.
            locations.forEach(location => {

                // Place a marker using the location's coordinates.
                const marker = L.marker([
                    location.Latitude,
                    location.Longitude
                ]).addTo(map);

                // Create popup content safely.
                const popup = document.createElement('div');

                const name = document.createElement('strong');
                name.textContent = location.Name;

                const address = document.createElement('p');
                address.textContent =
                    location.Address + ', ' + location.Postcode;

                const route = document.createElement('p');
                route.textContent = 'Recommended for: ' + location.Route;

                const distance = document.createElement('p');
                distance.textContent =
                    'Distance: ' + location.DistanceKm.toFixed(1) + ' km';

                // Add the information to the popup.
                popup.appendChild(name);
                popup.appendChild(address);
                popup.appendChild(route);
                popup.appendChild(distance);

                // Show the popup when the marker is clicked.
                marker.bindPopup(popup);

                // Remember this marker for the zoom calculation.
                markers.push(marker);
            });

            // Automatically zoom the map to show every marker.
            const markerGroup = L.featureGroup(markers);

            map.fitBounds(markerGroup.getBounds(), {
                padding: [30, 30],
                maxZoom: 14
            });
        }

    </script>
}
