@model IEnumerable<RE_Waste.Models.DropOffPoint>
@using RE_Waste.Extensions

@{
    ViewData["Title"] = "Drop-Off Points";
}

@* ====================================================================
   DROP-OFF POINTS (G2)
   The list sits in a white panel. Styles: "MANAGER AREA" in site.css.
   ==================================================================== *@
<div class="manager">

    <a class="manager-back"
       asp-area="Manager"
       asp-controller="Manager"
       asp-action="Index">
        Back to dashboard
    </a>

    <h1>Drop-off points</h1>

    <p class="manager-intro">
        Manage your drop-off points, update their details, and control their availability.
    </p>

    <div class="manager-toolbar">
        <a asp-area="Manager"
           asp-controller="DropOffPoints"
           asp-action="Create"
           class="button">
            Add drop-off point
        </a>
    </div>

    <div class="manager-panel">

        @* Scrolls sideways inside the panel on narrow screens, not the whole page. *@
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0 manager-table">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Type</th>
                        <th scope="col">Postcode</th>
                        <th scope="col">Status</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var point in Model.OrderBy(p => p.Name))
                        {
                            <tr class="@(point.IsActive ? "" : "is-inactive")">
                                <td class="fw-semibold">@point.Name</td>

                                <td>@point.PointType.ToDisplayName()</td>

                                <td>@point.Postcode</td>

                                <td>
                                    @if (point.IsActive)
                                    {
                                        <span class="badge rw-badge-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge rw-badge-inactive">Inactive</span>
                                    }
                                </td>

                                @* Edit, then switch the point on or off. *@
                                <td>
                                    <div class="manager-actions">
                                        <a asp-area="Manager"
                                           asp-controller="DropOffPoints"
                                           asp-action="Edit"
                                           asp-route-id="@point.Id"
                                           class="button-secondary button-small">
                                            Edit<span class="visually-hidden"> @point.Name</span>
                                        </a>

                                        <form asp-area="Manager"
                                              asp-controller="DropOffPoints"
                                              asp-action="ToggleActive"
                                              asp-route-id="@point.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="@(point.IsActive ? "button-danger" : "button") button-small">
                                                @(point.IsActive ? "Deactivate" : "Activate")<span class="visually-hidden"> @point.Name</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4">
                                No drop-off points found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>
