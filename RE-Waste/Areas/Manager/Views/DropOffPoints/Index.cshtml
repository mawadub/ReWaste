
@model IEnumerable<RE_Waste.Models.DropOffPoint>

@{
    ViewData["Title"] = "Drop-Off Points";
}

<h1>Drop-Off Points</h1>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Postcode</th>
                <th>Status</th>
                <th>Edit</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var point in Model.OrderBy(p => p.Name))
                {
                    <tr>
                        <td>@point.Name</td>

                        <td>@point.PointType</td>

                        <td>@point.Postcode</td>

                        <td>
                            @if (point.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactive
                                </span>
                            }
                        </td>

                        <td>
                            <a asp-area="Manager"
                               asp-controller="DropOffPoints"
                               asp-action="Edit"
                               asp-route-id="@point.Id"
                               class="btn btn-sm btn-primary">
                                Edit
                            </a>
                        </td>

                        <td>
                            <form asp-area="Manager"
                                  asp-controller="DropOffPoints"
                                  asp-action="ToggleActive"
                                  asp-route-id="@point.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm @(point.IsActive ? "btn-danger" : "btn-success")">
                                    @(point.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">
                        No drop-off points found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
