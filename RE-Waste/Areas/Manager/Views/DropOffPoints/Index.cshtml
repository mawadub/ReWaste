
@model IEnumerable<RE_Waste.Models.DropOffPoint>

@{
    ViewData["Title"] = "Drop-Off Points";
}

<h1 class="rw-page-title">Drop-Off Points</h1>

<p>
    Manage your drop-off points, update their details, and control their availability.
</p>

<div class="table-responsive rw-table-panel">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead class="rw-table-header">
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Postcode</th>
                <th>Status</th>
                <th>Edit</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var point in Model.OrderBy(p => p.Name))
                {
                    <tr>
                        <td class="fw-semibold">@point.Name</td>

                        <td>@point.PointType</td>

                        <td>@point.Postcode</td>

                        <td>
                            @if (point.IsActive)
                            {
                                <span class="badge rw-badge-active">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge rw-badge-inactive">
                                    Inactive
                                </span>
                            }
                        </td>

                        <td>
                            <a asp-area="Manager"
                               asp-controller="DropOffPoints"
                               asp-action="Edit"
                               asp-route-id="@point.Id"
                               class="btn btn-sm btn-rw-edit">
                                Edit
                            </a>
                        </td>

                        <td>
                            <form asp-area="Manager"
                                  asp-controller="DropOffPoints"
                                  asp-action="ToggleActive"
                                  asp-route-id="@point.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm @(point.IsActive ? "btn-rw-deactivate" : "btn-rw-activate")">
                                    @(point.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-4">
                        No drop-off points found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
