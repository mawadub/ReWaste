
@model RE_Waste.Models.DropOffPointModel

@{
    ViewData["Title"] = "Edit Drop-Off Point";
}

<h1>Edit Drop-Off Point</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-area="Manager"
              asp-controller="DropOffPoints"
              asp-action="Edit"
              asp-route-id="@ViewContext.RouteData.Values["id"]"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Postcode" class="form-label"></label>
                <input asp-for="Postcode" class="form-control" />
                <span asp-validation-for="Postcode"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PointType" class="form-label"></label>
                <input asp-for="PointType" class="form-control" />
                <span asp-validation-for="PointType"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OpeningHours"
                       class="form-label"></label>
                <input asp-for="OpeningHours"
                       class="form-control" />
                <span asp-validation-for="OpeningHours"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Website" class="form-label"></label>
                <input asp-for="Website" class="form-control" />
                <span asp-validation-for="Website"
                      class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsActive"
                       class="form-check-input" />
                <label asp-for="IsActive"
                       class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Save Changes
            </button>

            <a asp-area="Manager"
               asp-controller="DropOffPoints"
               asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}
