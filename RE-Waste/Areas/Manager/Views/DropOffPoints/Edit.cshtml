@model RE_Waste.Models.DropOffPointModel
@using RE_Waste.Extensions

@{
    ViewData["Title"] = "Edit Drop-Off Point";
}

@* ====================================================================
   EDIT DROP-OFF POINT (G2)
   One-column form in a white panel. Styles: "MANAGER AREA" in site.css.
   ==================================================================== *@
<div class="manager">

    <a class="manager-back"
       asp-area="Manager"
       asp-controller="DropOffPoints"
       asp-action="Index">
        Back to drop-off points
    </a>

    <h1>Edit drop-off point</h1>

    <div class="manager-panel manager-panel-narrow">

        <form asp-area="Manager"
              asp-controller="DropOffPoints"
              asp-action="Edit"
              asp-route-id="@ViewContext.RouteData.Values["id"]"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Postcode" class="form-label"></label>
                <input asp-for="Postcode" class="form-control" />
                <span asp-validation-for="Postcode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                @* A drop-down, so the type can't be mistyped. *@
                <label asp-for="PointType" class="form-label">Type</label>
                <select asp-for="PointType"
                        asp-items="DisplayNameSelectLists.PointTypes()"
                        class="form-select">
                </select>
                <span asp-validation-for="PointType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OpeningHours" class="form-label">Opening hours (optional)</label>
                <input asp-for="OpeningHours" class="form-control" />
                <span asp-validation-for="OpeningHours" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Website" class="form-label">Website (optional)</label>
                <input asp-for="Website" class="form-control" />
                <span asp-validation-for="Website" class="text-danger"></span>
            </div>

            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>

            @* Save first; Cancel goes back to the list without saving. *@
            <div class="manager-form-actions">
                <button type="submit" class="button">
                    Save changes
                </button>

                <a asp-area="Manager"
                   asp-controller="DropOffPoints"
                   asp-action="Index"
                   class="button-secondary">
                    Cancel
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
