@using RE_Waste.Models
@using RE_Waste.Models.Enums
@model Question

@{
    ViewData["Title"] = "Create Question";
}

@* ====================================================================
   CREATE QUESTION (G4)
   One-column form in a white panel. Styles: "MANAGER AREA" in site.css.
   ==================================================================== *@
<div class="manager">

    <a class="manager-back"
       asp-area="Manager"
       asp-controller="Questions"
       asp-action="Index">
        Back to questions
    </a>

    <h1>Create question</h1>

    <div class="manager-panel manager-panel-narrow">

        <form asp-area="Manager"
              asp-controller="Questions"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Text" class="form-label">Question text</label>
                <input asp-for="Text"
                       class="form-control"
                       maxlength="200"
                       required />
                <span asp-validation-for="Text" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AnswerType" class="form-label">Answer type</label>
                <select asp-for="AnswerType"
                        asp-items="Html.GetEnumSelectList<AnswerType>()"
                        class="form-select">
                </select>
                <span asp-validation-for="AnswerType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DeviceField" class="form-label">Device field</label>
                <select asp-for="DeviceField"
                        asp-items="Html.GetEnumSelectList<DeviceField>()"
                        class="form-select">
                </select>
                <span asp-validation-for="DeviceField" class="text-danger"></span>
            </div>

            @* Save first; Cancel goes back to the list without saving. *@
            <div class="manager-form-actions">
                <button type="submit" class="button">
                    Create question
                </button>

                <a asp-area="Manager"
                   asp-controller="Questions"
                   asp-action="Index"
                   class="button-secondary">
                    Cancel
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
