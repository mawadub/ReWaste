@using RE_Waste.Models
@using RE_Waste.Models.Enums
@model AnswerOption

@{
    ViewData["Title"] = "Edit Answer Option";
}

@* ====================================================================
   EDIT ANSWER OPTION (G4)
   One-column form in a white panel. Styles: "MANAGER AREA" in site.css.
   ==================================================================== *@
<div class="manager">

    <a class="manager-back"
       asp-area="Manager"
       asp-controller="Questions"
       asp-action="Edit"
       asp-route-id="@Model.QuestionId">
        Back to the question
    </a>

    <h1>Edit answer option</h1>

    <p class="manager-intro">
        <strong>Question:</strong> @ViewBag.QuestionText
    </p>

    <div class="manager-panel manager-panel-narrow">

        <form asp-area="Manager"
              asp-controller="Questions"
              asp-action="EditOption"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="QuestionId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Text" class="form-label">Option text</label>
                <input asp-for="Text"
                       class="form-control"
                       maxlength="100"
                       required />
                <span asp-validation-for="Text" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Value" class="form-label">Stored value</label>
                <input asp-for="Value"
                       class="form-control"
                       maxlength="50"
                       required />
                <span asp-validation-for="Value" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DisplayOrder" class="form-label">Display order</label>
                <input asp-for="DisplayOrder"
                       class="form-control"
                       type="number"
                       min="1"
                       required />
                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
            </div>

            @* Save first; Cancel goes back to the question without saving. *@
            <div class="manager-form-actions">
                <button type="submit" class="button">
                    Save changes
                </button>

                <a asp-area="Manager"
                   asp-controller="Questions"
                   asp-action="Edit"
                   asp-route-id="@Model.QuestionId"
                   class="button-secondary">
                    Cancel
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
