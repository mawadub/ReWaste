@{
    ViewData["Title"] = "Manager Dashboard";
}

<h1>Manager Dashboard</h1>

<p>Welcome to the RE-Waste Manager Area.</p>

<div class="row">
    <div class="col-md-4">
        <h3>Drop-off Points</h3>
        <p>Coming soon</p>
    </div>


    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Rules</h5>
            <p class="card-text">
                Manage recommendation rules for devices.
            </p>
            <a asp-area="Manager"
