@model RE_Waste.ViewModels.ManagerDashboardViewModel
@{
    ViewData["Title"] = "Manager Dashboard";
}

@* ====================================================================
   MANAGER DASHBOARD
   One white card per section. Styles: "MANAGER AREA" in site.css.
   ==================================================================== *@
<div class="manager">

    <h1>Manager dashboard</h1>

    <p class="manager-intro">
        Welcome to the RE-Waste manager area. Choose what you'd like to manage.
    </p>

    @* G5: the counts. Each card links to its management page, except saved results:
       managers only see the total, never the saved results or who owns them. *@
    <div class="manager-stats mt-3">

        <a asp-area="Manager"
           asp-controller="Questions"
           asp-action="Index"
           class="manager-panel manager-stat">
            <span class="manager-stat-number">@Model.ActiveQuestions</span>
            <span class="manager-stat-label">Active questions</span>
        </a>

        <a asp-area="Manager"
           asp-controller="Rules"
           asp-action="Index"
           class="manager-panel manager-stat">
            <span class="manager-stat-number">@Model.ActiveRules</span>
            <span class="manager-stat-label">Active rules</span>
        </a>

        <a asp-area="Manager"
           asp-controller="DropOffPoints"
           asp-action="Index"
           class="manager-panel manager-stat">
            <span class="manager-stat-number">@Model.DropOffPoints</span>
            <span class="manager-stat-label">Drop-off points</span>
        </a>

        <div class="manager-panel manager-stat">
            <span class="manager-stat-number">@Model.SavedResults</span>
            <span class="manager-stat-label">Saved results</span>
        </div>

    </div>

    @* One column on phones, side by side when there's room. *@
    <div class="manager-grid mt-3">

        <div class="manager-panel manager-card">
            <h2>Drop-off points</h2>
            <p>Add and update the places users can take their phones, and switch them on or off.</p>
            <a asp-area="Manager"
               asp-controller="DropOffPoints"
               asp-action="Index"
               class="button">
                Manage drop-off points
            </a>
        </div>

        <div class="manager-panel manager-card">
            <h2>Recommendation rules</h2>
            <p>Decide which route the wizard recommends for each kind of phone.</p>
            <a asp-area="Manager"
               asp-controller="Rules"
               asp-action="Index"
               class="button">
                Manage rules
            </a>
        </div>

        <div class="manager-panel manager-card">
            <h2>Wizard questions</h2>
            <p>Edit, reorder and switch on or off the questions and their answer options.</p>
            <a asp-area="Manager"
               asp-controller="Questions"
               asp-action="Index"
               class="button">
                Manage questions
            </a>
        </div>

    </div>
</div>
